namespace strace-viewer

from /core/documents import make-document-string
from /generated/template/strace-viewer import make-template-engine
from /streaky/template import text-value

public function render-page string; source string
    encoded = make-document-string; source
    # HTML script elements recognize closing tags even inside JavaScript strings.
    # Escaping every '<' also covers mixed-case closing tags and comment openers.
    source-json = encoded.encoded.replace; '<', '\\u003c'
    engine = make-template-engine;
    engine.assign; 'title', (text-value; 'strace-viewer')
    engine.assign; 'source', (text-value; source-json)
    engine.assign; 'remote', (text-value; 'false')
    return engine.fetch; 'index.html'

function render-remote-page string;
    engine = make-template-engine;
    engine.assign; 'title', (text-value; 'strace-viewer')
    engine.assign; 'source', (text-value; '""')
    engine.assign; 'remote', (text-value; 'true')
    return engine.fetch; 'index.html'
