namespace strace-viewer

from /core/collections import list, range
from /core/regex import compile, regex-pattern, regex-captures

class capture-row
    id int = 0
    line-number int = 0
    raw string = ''
    status string = 'raw'
    syscall string = ''
    args string = ''
    result string = ''
    actual string = ''
    pid string = ''
    timestamp string = ''
    duration string = ''
    fd string = ''
    payload string = ''
    truncated bool = false

    function construct; id int, line-number int, raw string
        this.id = id
        this.line-number = line-number
        this.raw = raw

# Locate the call's closing delimiter without mistaking quoted/nested ')' for it.
function call-close int; source bytes, start int, initial bool
    expected list of uint8 = list;
    if initial
        expected.append; 41
    quote uint8 = 0
    escaped bool = false
    index = start
    while index < source.length
        value = source[index]
        if quote != 0
            if escaped
                escaped = false
            else if value == 92
                escaped = true
            else if value == quote
                quote = 0
        else if value == 34 or value == 39
            quote = value
        else if value == 40
            expected.append; 41
        else if value == 91
            expected.append; 93
        else if value == 123
            expected.append; 125
        else if value == 41 or value == 93 or value == 125
            if expected.length == 0
                if value == 41
                    return index
            else
                if expected[expected.length - 1] != value
                    return -1
                expected.remove; expected.length - 1
                if initial and expected.length == 0
                    return index
        index++
    return -1

private function group-text string; captures ref regex-captures, index int
    captured = captures.group; index
    if captured != none
        return captured.text
    return ''

class row-decoder
    private prefix regex-pattern
    private resumed regex-pattern
    private tail regex-pattern
    private descriptor regex-pattern
    private quoted regex-pattern
    private number regex-pattern

    function construct;
        # Preserve the old trace grammar, not the new engine's \s, \d, \w or dot.
        space = '[\t-\r\p{Zs}\x{2028}\x{2029}\x{FEFF}]'
        line-char = '[^\r\n\x{2028}\x{2029}]'
        leader = '(?:(?:\[pid' + space + '+)?([0-9]+(?:\.[0-9]+)?)\]?' + space + '+)?'
        call = '([A-Za-z_][A-Za-z_0-9]*)'
        this.prefix = compile; '^' + leader + leader + call + '\('
        this.resumed = compile; '^' + leader + leader + '<\.\.\.' + space + '+' + call + space + '+resumed>' + space + '*,?' + space + '*'
        this.tail = compile; '^' + space + '+=' + space + '+(' + line-char + '*?)(?:' + space + '+<([0-9.]+)>' + space + '*)?$'
        this.descriptor = compile; '^(-?[0-9]+)(?:<[^>]*>)?'
        this.quoted = compile; '"((?:\\\\' + line-char + '|[^"\\\\])*)"'
        this.number = compile; '^-?[0-9]+'

    function decode capture-row; id int, line-number int, raw string
        row = instance capture-row; id, line-number, raw
        text = raw.trim;
        data = text.encode; utf8
        found = this.prefix.captures; text
        resumed = false
        if found == none
            found = this.resumed.captures; text
            resumed = found != none
        if found != none
            whole = found.group; 0
            # Group zero always participates, but group(index) returns an optional range.
            # The backend currently emits bytes.end as i128, not as a Terrane Int.
            start int128 = 0
            if whole != none
                start = whole.bytes.end
            else
                return row
            first = group-text; found, 1
            second = group-text; found, 2
            syscall = group-text; found, 3
            unfinished = not resumed and (text.contains.end; '<unfinished ...>')
            args string = ''
            result string = ''
            duration string = ''
            if unfinished
                rest = data[range; start, data.length].decode; utf8
                args = rest
                    .trim.end; '<unfinished ...>'
                    .trim.end;
            else
                close = call-close; data, start, not resumed
                if close < 0
                    return row
                rest = data[range; close + 1, data.length].decode; utf8
                ending = this.tail.captures; rest
                if ending != none
                    result = group-text; ending, 1
                    duration = group-text; ending, 2
                else
                    return row
                args = data[range; start, close].decode; utf8
            row = {
                status = 'parsed'
                syscall = syscall
            }
            if resumed
                row = {
                    status = 'resumed'
                    syscall = '*' + syscall
                }
            if unfinished
                row = {
                    status = 'unfinished'
                    syscall = '!' + syscall
                }
            if first.contains; '.'
                row.timestamp = first
            else
                row.pid = first
            if second.contains; '.'
                row.timestamp = second
            else if second != ''
                row.pid = second
            row = {
                args = args
                result = result
                duration = duration
            }
            fd = this.descriptor.captures; args
            if fd != none
                row.fd = group-text; fd, 1
            quoted = this.quoted.captures; args
            if quoted != none
                row.payload = group-text; quoted, 1
            actual = this.number.match; result
            if actual != none
                row.actual = actual.text
            row.truncated = args.contains; '...'
        return row
